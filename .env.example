# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# Public URL of the website (used in password-reset emails)
APP_URL=http://localhost:5173

# PostgreSQL connection (docker-compose.yml provides this one for local development)
DATABASE_URL=postgresql://health_synapsis:health_synapsis_dev@localhost:5434/health_synapsis?schema=public

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Clinic timezone (EMR same-day editing, no-show job, reports)
CLINIC_TZ=Asia/Karachi

# Email (password resets, contact form). Local dev uses Mailpit from docker-compose (inbox: http://localhost:8026).
# Leave SMTP_HOST empty to print emails to the server console instead.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Health Synapsis <no-reply@example.com>"
# Where website contact-form messages are emailed (optional; they are always stored in the database)
CONTACT_TO=

# First super admin, created by `npm run db:seed` (password must meet the policy)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=

# Facility whose doctors/services/contact details appear on the public website (optional; defaults to the first one)
WEBSITE_FACILITY_ID=

# Set to true to also seed a demo facility with sample users (development only)
SEED_DEMO=false
DEMO_PASSWORD=

# Where uploaded files are stored
STORAGE_DIR=./server/storage
